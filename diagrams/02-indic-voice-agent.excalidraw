      "versionNonce": 1815195272,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785000000000,
      "link": null,
      "locked": false,
      "text": "THE HARD PART \u2014 say this unprompted\nCode-mixed Telugu/English breaks naive pipelines: the STT has to survive\nintra-sentence language switching, and Indic scripts inflate token counts\n3\u20138x per character vs English \u2014 which moves both cost and TTFT.\nReport Telugu WER and code-mixed WER separately; the gap is the story.",
      "originalText": "THE HARD PART \u2014 say this unprompted\nCode-mixed Telugu/English breaks naive pipelines: the STT has to survive\nintra-sentence language switching, and Indic scripts inflate token counts\n3\u20138x per character vs English \u2014 which moves both cost and TTFT.\nReport Telugu WER and code-mixed WER separately; the gap is the story.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "el1738417689",
      "lineHeight": 1.25,
      "autoResize": false
    }
