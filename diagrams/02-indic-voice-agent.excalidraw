      "updated": 1785000000000,
      "link": null,
      "locked": false,
      "text": "A new client deploys by swapping a config folder.\nZero code changes, zero rebuild. This is the line that\nmakes it sound like a product rather than a demo.",
      "originalText": "A new client deploys by swapping a config folder.\nZero code changes, zero rebuild. This is the line that\nmakes it sound like a product rather than a demo.",
