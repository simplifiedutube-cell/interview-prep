      "versionNonce": 241643359,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785000000000,
      "link": null,
      "locked": false,
      "text": "METRICS \u2014 never lead with accuracy\n  \u00b7 state the majority-class baseline FIRST; the lift is the number\n  \u00b7 FN = a student who needed help and didn't get it\n  \u00b7 FP = a short advisor conversation\n  Those costs are not equal, so 0.5 was never the right threshold.",
      "originalText": "METRICS \u2014 never lead with accuracy\n  \u00b7 state the majority-class baseline FIRST; the lift is the number\n  \u00b7 FN = a student who needed help and didn't get it\n  \u00b7 FP = a short advisor conversation\n  Those costs are not equal, so 0.5 was never the right threshold.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "el1103334560",
      "lineHeight": 1.25,
      "autoResize": false
    },
