    "fontSize": "13px",
    "primaryColor": "#FFFFFF",
    "primaryTextColor": "#18222E",
    "primaryBorderColor": "#5A6673",
    "lineColor": "#5A6673",
    "clusterBkg": "#F0F2ED",
    "clusterBorder": "#DFE3DA",
    "edgeLabelBackground": "#F5F6F2"
